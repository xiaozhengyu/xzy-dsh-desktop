{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH-Desktop",
  "version": "0.1.0",
  "identifier": "com.deepseek.harness-desktop",
  "build": {
    "beforeDevCommand": "npm run dev:front",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:front",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DSH 桌面端",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "additionalBrowserArgs": "--proxy-bypass-list=<-loopback>",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "DeepSeek",
    "category": "DeveloperTool",
    "shortDescription": "DSH 桌面端（Tauri 壳）",
    "longDescription": "DSH 的 Windows 11 桌面封装：低内存、系统托盘常驻、一键启动 dsh web 服务，不内嵌 Node.js。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
